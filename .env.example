# Auth (required): random secret for signing sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: Postgres connection string (Supabase, Neon, etc.).
# Leave unset for local development — the app falls back to an embedded
# PGlite database stored in ./.pglite.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: OpenAI API key. Upgrades job matching from keyword overlap to
# semantic embedding scores, and powers resume tailoring (phase 2).
# Server-side only, never exposed to the browser.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini

# Optional: Adzuna keys (free at https://developer.adzuna.com) add on-site
# and local jobs to the matches. Without them, remote jobs from Remotive
# (no key needed) still work out of the box.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us
