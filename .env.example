# Auth (required): random secret for signing sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: Postgres connection string (Supabase, Neon, etc.).
# Leave unset for local development — the app falls back to an embedded
# PGlite database stored in ./.pglite.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: AI provider (any OpenAI-compatible API). Powers resume/cover
# letter tailoring and semantic job matching. Server-side only.
#
# FREE option — Google Gemini (no credit card, ~1,500 req/day):
#   Get a key at https://aistudio.google.com/apikey
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your-gemini-key
#
# Paid option — OpenAI (defaults: gpt-5-mini, text-embedding-3-small):
# OPENAI_API_KEY=sk-...
#
# Overrides (auto-detected sensible defaults per provider):
# AI_MODEL=
# AI_EMBEDDING_MODEL=

# Optional: Adzuna keys (free at https://developer.adzuna.com) add on-site
# and local jobs to the matches. Without them, remote jobs from Remotive
# (no key needed) still work out of the box.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us
