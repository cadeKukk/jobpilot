# REQUIRED for AI features: Cursor API key.
# Create one at https://cursor.com/dashboard → Integrations.
# Powers Fable 5 fit analysis, resume/cover-letter tailoring, and Pilot chat.
CURSOR_API_KEY=

# Optional: pin the model ID. By default the app queries your account's
# model list and picks the Fable 5 model automatically.
# CURSOR_MODEL=

# Optional: owner identity (defaults shown).
# OWNER_NAME=Cade Kukk
# OWNER_EMAIL=cadekukk@gmail.com

# Optional: Postgres connection string (Supabase, Neon, etc.).
# Leave unset for local development — the app uses the local PGlite server
# started by `npm run dev` (data in ./.pglite).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: Adzuna keys (free at https://developer.adzuna.com) add US
# on-site/hybrid jobs. Remotive (remote), cv.ee (Estonia), Arbeitnow (EU),
# and RemoteOK (remote) work with no keys at all.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us

# Optional: RapidAPI key (free tier at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
# unlocks JSearch — Google for Jobs results, which include LinkedIn, Indeed,
# Glassdoor, and ZipRecruiter postings.
# RAPIDAPI_KEY=
